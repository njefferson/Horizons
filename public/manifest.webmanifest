{
  "name": "Quietkeep",
  "short_name": "Quietkeep",
  "description": "A free, local-first planner that brings back everything you put in. No accounts, no telemetry, no server.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F4F1E9",
  "theme_color": "#F4F1E9",
  "lang": "en",
  "icons": [
    { "src": "./brand/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./brand/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "./brand/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Put something down",
      "short_name": "Capture",
      "description": "Open Quietkeep straight to an empty capture line",
      "url": "./?capture=1",
      "icons": [{ "src": "./brand/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
